---
interface SocialPost {
  image: string;
  platform: 'instagram' | 'tiktok' | 'youtube' | 'x';
  href: string;
  alt: string;
}

interface Props {
  posts: SocialPost[];
}

const { posts } = Astro.props;
---

<!-- Testimonials section — video thumbnails link to Vimeo embeds. -->
<section id="testimonios" class="bg-white py-20 md:py-28">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <!-- Header -->
    <div class="mb-12 flex items-end justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.3em] text-brand-gold mb-2">Casos de éxito</p>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black uppercase tracking-tighter text-[#0d1225] leading-none">
          Clientes reales.<br />Resultados reales.
        </h2>
      </div>
      <p class="hidden sm:block text-[#0d1225]/30 text-xs uppercase tracking-widest max-w-[160px] text-right leading-relaxed">
        Testimoniales en video
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 md:gap-3 lg:gap-4 auto-rows-[160px] sm:auto-rows-[200px] md:auto-rows-[260px] grid-flow-dense">
      {
        posts.map((post, index) => {
          const gridClasses =
            index === 0 ? "col-span-1 row-span-2 md:col-span-2 md:row-span-2" :
            index === 1 ? "col-span-1 row-span-1 md:col-span-2 md:row-span-1" :
            index === 2 ? "col-span-1 row-span-1 md:col-span-1 md:row-span-2" :
            index === 4 ? "col-span-2 row-span-1 md:col-span-2 md:row-span-2" :
            "col-span-1 row-span-1";

          return (
            <a
              href={post.href}
              target="_blank"
              rel="noopener noreferrer"
              class={`group relative overflow-hidden bg-[#0d1225]/5 w-full h-full ${gridClasses}`}
              aria-label={post.alt}
            >
              <img
                src={post.image}
                alt={post.alt}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              <!-- Play button overlay -->
              <div class="absolute inset-0 bg-white/0 group-hover:bg-[#0d1225]/50 transition-all duration-300 flex items-center justify-center">
                <div class="opacity-0 group-hover:opacity-100 transition-all duration-300 scale-75 group-hover:scale-100">
                  <div class="w-14 h-14 rounded-full bg-brand-gold flex items-center justify-center shadow-lg">
                    <svg class="w-5 h-5 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
