---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation";
import HeroCanvas from "../components/HeroCanvas";
import PainPoints from "../components/PainPoints.astro";
import TrackTiles from "../components/TrackTiles.astro";
import PricingPackages from "../components/PricingPackages.astro";
import MilestonesScroll from "../components/MilestonesScroll";
import Partnerships from "../components/Partnerships.astro";
import FAQ from "../components/FAQ.astro";
import StoreSection from "../components/StoreSection.astro";
import Footer from "../components/Footer.astro";

const navLinks = [
  { label: "Servicios", href: "#servicios" },
  { label: "Paquetes", href: "#paquetes" },
  { label: "Proceso", href: "#proceso" },
  { label: "Contacto", href: "#contacto" },
];

const socialLinks = [
  { name: "Instagram", href: "#" },
  { name: "TikTok", href: "#" },
  { name: "YouTube", href: "#" },
  { name: "X", href: "#" },
];

// Service pillars — using existing imagery as abstract backgrounds
const serviceTiles = [
  {
    id: "estrategia",
    title: "Estrategia",
    subtitle: "Investigación · Buyer persona · Benchmarking",
    image: "/images/dinamo.jpeg",
    href: "#paquetes",
  },
  {
    id: "creatividad",
    title: "Creatividad",
    subtitle: "Copy · Diseño · Video · Reels · Logotipo",
    image: "/images/dinamo-2.jpeg",
    href: "#paquetes",
  },
  {
    id: "tecnologia",
    title: "Tecnología",
    subtitle: "Google Ads · Meta Ads · TikTok · SEO",
    image: "/images/dinamo-5.jpeg",
    href: "#paquetes",
  },
  {
    id: "seguimiento",
    title: "Seguimiento",
    subtitle: "Dashboard · Métricas · Reportes · CRM",
    image: "/images/dinamo-4.jpeg",
    href: "#paquetes",
  },
];

// Credentials and platforms grid
const credentials = [
  { name: "16 años\nde experiencia" },
  { name: "Socios\nde Google" },
  { name: "+$500,000\nen pauta mensual" },
  { name: "+300 marcas\nsatisfechas" },
  { name: "Google Ads" },
  { name: "Meta Ads" },
  { name: "TikTok Ads" },
  { name: "LinkedIn Ads" },
  { name: "SEO" },
  { name: "Claude · ChatGPT\nMidjourney · Runway" },
];

---

<Layout
  title="dínamo | Agencia de Publicidad y Marketing Digital · México"
  description="Construimos tu ecosistema digital completo — Google Ads, Meta Ads, contenido, landing pages y seguimiento de prospectos. 16 años de experiencia, socios de Google, +300 marcas satisfechas."
>
  <Navigation client:load links={navLinks} socialLinks={socialLinks} />

  <main>
    <!-- Hero: animación de canvas con frames — texto actualizado al nuevo copy -->
    <HeroCanvas client:load />

    <!-- ¿Te suena alguno de estos? + diagnóstico + IA -->
    <PainPoints />

    <!-- 4 pilares del servicio: Estrategia / Creatividad / Tecnología / Seguimiento -->
    <TrackTiles tiles={serviceTiles} />

    <!-- Paquetes de servicio con precios -->
    <PricingPackages />

    <!-- Cómo trabajamos: 5 pasos en scroll horizontal -->
    <MilestonesScroll client:visible />

    <!-- Credenciales y plataformas -->
    <Partnerships partners={credentials} />

    <!-- FAQ -->
    <FAQ />

    <!-- Contacto: formulario con calificación por presupuesto, urgencia y canal -->
    <StoreSection />
  </main>

  <Footer navLinks={navLinks} />
</Layout>
