<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 700" width="900" height="700">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0d0d0d"/>
      <stop offset="100%" style="stop-color:#161616"/>
    </linearGradient>
  </defs>
  <rect width="900" height="700" fill="url(#bg)"/>
  <circle cx="450" cy="350" r="250" fill="#b5f900" opacity="0.06"/>
  <text x="450" y="320" text-anchor="middle" font-family="Arial Black" font-size="80" fill="#b5f900" opacity="0.15" font-weight="900">OFF</text>
  <rect x="280" y="380" width="340" height="80" rx="4" fill="#b5f900" opacity="0.85"/>
  <text x="450" y="410" text-anchor="middle" font-family="Arial" font-size="18" fill="#000" font-weight="bold">OFF TRACK</text>
  <text x="450" y="440" text-anchor="middle" font-family="Arial" font-size="13" fill="#000" opacity="0.7">Place off-track.jpg in public/images/</text>
</svg>
