<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1080" width="1920" height="1080">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0a0a0a"/>
      <stop offset="50%" style="stop-color:#1a1a1a"/>
      <stop offset="100%" style="stop-color:#0d0d0d"/>
    </linearGradient>
    <linearGradient id="accent" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#b5f900;stop-opacity:0.3"/>
      <stop offset="100%" style="stop-color:#ff6600;stop-opacity:0.1"/>
    </linearGradient>
  </defs>
  <rect width="1920" height="1080" fill="url(#bg)"/>
  <rect width="1920" height="1080" fill="url(#accent)"/>
  <!-- Grid pattern -->
  <line x1="0" y1="540" x2="1920" y2="540" stroke="#ffffff" stroke-width="0.5" opacity="0.05"/>
  <line x1="960" y1="0" x2="960" y2="1080" stroke="#ffffff" stroke-width="0.5" opacity="0.05"/>
  <!-- Diagonal accent -->
  <polygon points="0,0 800,0 400,1080 0,1080" fill="#b5f900" opacity="0.03"/>
  <!-- Number 4 -->
  <text x="960" y="600" text-anchor="middle" font-family="Arial Black" font-size="600" fill="#b5f900" opacity="0.04" font-weight="900">4</text>
  <!-- McLaren orange stripe -->
  <rect x="0" y="0" width="8" height="1080" fill="#ff6600" opacity="0.6"/>
  <rect x="1912" y="0" width="8" height="1080" fill="#ff6600" opacity="0.2"/>
  <!-- Placeholder label -->
  <rect x="760" y="460" width="400" height="160" rx="4" fill="#b5f900" opacity="0.9"/>
  <text x="960" y="530" text-anchor="middle" font-family="Arial" font-size="24" fill="#000" font-weight="bold">HERO IMAGE</text>
  <text x="960" y="565" text-anchor="middle" font-family="Arial" font-size="16" fill="#000" opacity="0.7">Place hero-bg.jpg in public/images/</text>
  <text x="960" y="595" text-anchor="middle" font-family="Arial" font-size="14" fill="#000" opacity="0.6">Recommended: 1920×1080px, Lando Norris F1 photo</text>
</svg>
